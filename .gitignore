# OS junk
Thumbs.db
desktop.ini
.DS_Store

# Slicer output — regenerate from source models, don't version
*.gcode
*.bgcode
*.3mf.backup

# Python environment — rebuild from ml/requirements.txt, never commit
.venv/
__pycache__/
*.pyc

# Simulator binary (~236 MB) — download from the gym-donkeycar GitHub release
sim/
# ...and the log the Unity sim drops in the working directory when it runs
unitylog.txt

# Training data and model weights — large and regenerable
ml/data/
ml/checkpoints/
*.pt
*.ckpt

# ml/runs/ is deliberately NOT ignored wholesale. The weights are (above),
# but the RESULTS — loss histories, reconstruction grids, rollout panels,
# metrics — are the experiment evidence this project exists to produce, and
# they are ~1 MB total. Versioning them means a claim in the record can
# always be traced to the artifact that produced it.
